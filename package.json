{
  "name": "agent-in-box",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=11.22.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm -r --parallel --filter @agent-in-box/web --filter @agent-in-box/control-plane run dev",
    "dev:desktop": "node scripts/dev-desktop.mjs",
    "build:packages": "pnpm --filter \"./packages/**\" -r --if-present build",
    "build:go": "go build ./...",
    "build": "pnpm -r --if-present build && pnpm build:go",
    "typecheck": "pnpm -r --if-present typecheck",
    "test:go": "go test ./...",
    "test": "pnpm build:packages && pnpm -r --if-present test && pnpm test:go",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css,html,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,css,html,yaml,yml}\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "package:control-plane": "node scripts/package-control-plane.mjs",
    "package:prepare": "pnpm build:packages && pnpm --filter @agent-in-box/control-plane build && pnpm --filter @agent-in-box/web build && node scripts/package-control-plane.mjs && pnpm --filter @agent-in-box/desktop build",
    "package:desktop": "pnpm package:prepare && pnpm --filter @agent-in-box/desktop dist",
    "package:desktop:dir": "pnpm package:prepare && pnpm --filter @agent-in-box/desktop pack:dir",
    "package:desktop:win": "pnpm package:prepare && pnpm --filter @agent-in-box/desktop dist:win",
    "package:desktop:win:portable": "pnpm package:prepare && pnpm --filter @agent-in-box/desktop dist:win:portable",
    "smoke:phase2": "pnpm build:packages && pnpm --filter @agent-in-box/control-plane build && pnpm --filter @agent-in-box/web build && node scripts/smoke-phase2.mjs",
    "smoke:desktop": "node scripts/smoke-desktop-package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
