CONTROL_PLANE_HOST=127.0.0.1
CONTROL_PLANE_PORT=3000
WEB_DEV_PORT=5173

# Optional phase-3/4 service integration. Processes must use the same data root.
AGENT_IN_BOX_SUPERVISOR_URL=http://127.0.0.1:7610
# AGENT_IN_BOX_IMAGE_MANIFEST=F:\\AgentInBox\\config\\images.json
# AGENT_IN_BOX_SUPERVISOR_TOKEN_FILE=F:\\AgentInBox\\supervisor-acl.token
# Prefer <data-root>\\vms\\<vm-id>\\guest-agent.token per VM. This shared file is
# only a development/legacy-image fallback and must match the guest -token-file.
# AGENT_IN_BOX_GUEST_TOKEN_FILE=F:\\AgentInBox\\guest-agent.token

# Phase 6: Worker RPC and Model Broker. Per-VM Worker RPC token lives at
# <vm-storage-root>\\worker-rpc.token and must match the Guest systemd token file.
# AGENT_IN_BOX_WORKER_TOKEN_FILE is a development fallback shared by all VMs.
# AGENT_IN_BOX_WORKER_TOKEN_FILE=F:\\AgentInBox\\worker-rpc.token
AGENT_IN_BOX_MODEL_BROKER_HOST=127.0.0.1
AGENT_IN_BOX_MODEL_BROKER_PORT=6719
# Guest-facing URL of the host broker. QEMU user networking exposes the host
# loopback as 10.0.2.2; tests may override this with a loopback URL.
# AGENT_IN_BOX_MODEL_BROKER_GUEST_URL=http://10.0.2.2:6719
# Electron writes this descriptor and holds the real provider key in safeStorage.
# AGENT_IN_BOX_CREDENTIAL_BRIDGE_DESCRIPTOR=C:\\Users\\me\\AppData\\Roaming\\AgentInBox\\credential-bridge.json
# Development/Smoke only: 0600 JSON object mapping credentialProviderId -> secret.
# AGENT_IN_BOX_MODEL_CREDENTIALS_FILE=F:\\AgentInBox\\model-credentials.json

# Phase 7: Computer Use Broker. Guest Pi extensions call this host loopback
# endpoint with a short-lived per-Worker token; the broker enforces task,
# Worker, VM and Execution Lease checks before calling the Guest Agent.
AGENT_IN_BOX_CUA_BROKER_HOST=127.0.0.1
AGENT_IN_BOX_CUA_BROKER_PORT=6720
# AGENT_IN_BOX_CUA_BROKER_GUEST_URL=http://10.0.2.2:6720

# Phase 9: Resource Manager tick. Manual reconcile remains available through
# POST /api/v1/resources/reconcile. The Guest Agent workspace archive/restore
# roots are configured with `-workspace-roots` / AGENT_IN_BOX_WORKSPACE_ROOTS
# (guest-side) and default to /home:/tmp.
# AGENT_IN_BOX_RESOURCE_TICK_MS=5000

# Phase 10: local Feishu and QQ bot connectors. Bot secrets use the same
# Electron credential bridge as model credentials (credentialProviderId looks
# like bot-feishu-<appid>). For development/Smoke only, a 0600 JSON file may
# map bot credential ids to secrets.
# AGENT_IN_BOX_BOT_CREDENTIALS_FILE=F:\\AgentInBox\\bot-credentials.json
# Connection supervision, durable ingress, outbound retry and notification
# polling intervals (milliseconds). Keep the defaults in production.
# AGENT_IN_BOX_BOT_TICK_MS=2000
# AGENT_IN_BOX_BOT_INGRESS_TICK_MS=750
# AGENT_IN_BOX_BOT_OUTBOUND_TICK_MS=500
# AGENT_IN_BOX_BOT_NOTIFICATION_TICK_MS=500
