{
  "name": "@agent-in-box/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "pack:dir": "electron-builder --dir --config electron-builder.yml",
    "dist": "electron-builder --config electron-builder.yml",
    "dist:win": "electron-builder --win nsis --config electron-builder.yml",
    "dist:win:portable": "electron-builder --win portable --config electron-builder.yml",
    "dist:linux": "electron-builder --linux --config electron-builder.yml"
  },
  "devDependencies": {
    "@agent-in-box/protocol": "workspace:*",
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  }
}
