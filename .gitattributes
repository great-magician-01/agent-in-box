# Normalize every text file to LF in the repository. Windows checkouts may use
# CRLF in the working tree, but committed content and CI always see LF.
* text=auto eol=lf

*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.gz binary
*.tgz binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.qcow2 binary
*.iso binary
